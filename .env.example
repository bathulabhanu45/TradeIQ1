# TradeIQ Environment Configuration
# Copy this file to .env and configure your MySQL credentials

# Flask Application Settings
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=tradeiq-super-secret-key-2026

# MySQL Database Settings (MySQL 8)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=ecommerce_bi

# Dual-Engine Fallback: If MySQL is not reachable or credentials fail,
# enable seamless SQLite database backup so development/evaluation never halts.
ALLOW_SQLITE_FALLBACK=True
